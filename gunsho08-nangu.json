 ],
 "poems": [
  {
   "seq": "1",
   "text": "えり殘しにてせよと度〓人の夢にみゆるによ",
   "kana": "",
   "speaker": "",
   "page": 64,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "2",
   "text": "ありし世にかはらぬ秋の月影は昔の友にあふこふちする",
   "kana": "",
   "speaker": "",
   "page": 64,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "3",
   "text": "月よみの神も昔をわすれすは普き影に我をもらすな",
   "kana": "",
   "speaker": "",
   "page": 64,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "4",
   "text": "久堅の空ゆく月にさそはれてうき身もしはし心をそやる",
   "kana": "",
   "speaker": "",
   "page": 64,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "5",
   "text": "秋のよの月みる程もなくさまていと〓ゆかしき雲のうへ哉",
   "kana": "",
   "speaker": "",
   "page": 64,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "6",
   "text": "出る日の光はるかにたけ行はてるとそみゆる峯の紅葉は",
   "kana": "",
   "speaker": "",
   "page": 64,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "7",
   "text": "霧のまに峯のもみちに尋ぬとてひもたけにけり高圓の山",
   "kana": "",
   "speaker": "",
   "page": 64,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "8",
   "text": "秋霧の朝な夕なに立田山晝そ紅葉の色は見えける",
   "kana": "",
   "speaker": "",
   "page": 64,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "9",
   "text": "紅にそむる時雨のひるまにもぬれ色にのみみゆるもみちは",
   "kana": "",
   "speaker": "",
   "page": 64,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "10",
   "text": "終夜しけみにしのふさをしかもあけつけとりと今そ鳴なる",
   "kana": "",
   "speaker": "",
   "page": 64,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "11",
   "text": "秋深み霜まつ峯の鐘の音に聲うちそへてをしか鳴ん",
   "kana": "",
   "speaker": "",
   "page": 64,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "12",
   "text": "衣手の山のすそ野にたつ鹿のうら淋しきは曉のこゑ",
   "kana": "",
   "speaker": "",
   "page": 64,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "13",
   "text": "何ことをおもふなるらん鈴虫の夕くれなゐにふりいてゝなく",
   "kana": "",
   "speaker": "",
   "page": 64,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "14",
   "text": "夕されは蓬かれやのきり〓〓す枕の下に聲そ聞ゆる",
   "kana": "",
   "speaker": "",
   "page": 64,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "15",
   "text": "夕されは淺茅かうへの露寒み誰まつ虫の下になくらん",
   "kana": "",
   "speaker": "",
   "page": 64,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "16",
   "text": "ひくまのゝゆふつけをけるくら〓〓に聲たてゝなく轡虫かな",
   "kana": "",
   "speaker": "",
   "page": 64,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "17",
   "text": "秋はきにおく白露の玉ゆらも戀しき人はわすれやはする",
   "kana": "",
   "speaker": "",
   "page": 64,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "18",
   "text": "萩のえにまかひし袖の白露はあひみぬ程に色つきにけり",
   "kana": "",
   "speaker": "",
   "page": 64,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "19",
   "text": "戀ふれとも粟津の原に咲萩の花と散なん名社おしけれ",
   "kana": "",
   "speaker": "",
   "page": 64,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "20",
   "text": "まくすはふ小野の糸萩くりかへし恨めしなから猶そ戀しき",
   "kana": "",
   "speaker": "",
   "page": 64,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "21",
   "text": "あたなりといはれの野への女郞花なと我にしもなひかさる覽",
   "kana": "",
   "speaker": "",
   "page": 64,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "22",
   "text": "みをつめは哀とそみるをみなへし人もこす野の露にしほる〓",
   "kana": "",
   "speaker": "",
   "page": 64,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "23",
   "text": "女郞花なひかす風にみをなして人を心にまかせてしかな",
   "kana": "",
   "speaker": "",
   "page": 64,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "24",
   "text": "我のみとおもふ夕へに女郞花誰をこふとて露けかるらん",
   "kana": "",
   "speaker": "",
   "page": 64,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "25",
   "text": "逢ことはさこそかた野にたてりとも忍ひてなひけしのゝ小薄",
   "kana": "",
   "speaker": "",
   "page": 64,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "26",
   "text": "わか身からうきふししけきしの薄忍ふとたにもしらすや有覽",
   "kana": "",
   "speaker": "",
   "page": 64,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "27",
   "text": "花す〓き招くをよそにみし物を我もほにいて〓人そ戀しき",
   "kana": "",
   "speaker": "",
   "page": 65,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "28",
   "text": "篠原やをさ〓ましりの村薄よをならへてもつらき君哉",
   "kana": "",
   "speaker": "",
   "page": 65,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "29",
   "text": "待人を荻の葉とたに思ひせは風のつてにも音はしてまし",
   "kana": "",
   "speaker": "",
   "page": 65,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "30",
   "text": "うきことを風のつてにも聞つれは荻の上葉の露そこほるち",
   "kana": "",
   "speaker": "",
   "page": 65,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "31",
   "text": "我戀の荻ふく風の音ならはしられてかくは歎かさらまし",
   "kana": "",
   "speaker": "",
   "page": 65,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "32",
   "text": "に分こし人は音もせてそよと聞ゆる荻の上風",
   "kana": "",
   "speaker": "",
   "page": 65,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "33",
   "text": "徒にやとに匂へる藤はかま戀しき人のきてもみよかし",
   "kana": "",
   "speaker": "",
   "page": 65,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "34",
   "text": "うらやましみやけかはらの蘭たれにむつれて紐ときつらん",
   "kana": "",
   "speaker": "",
   "page": 65,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "35",
   "text": "わきもこか裾野に匂ふ蘭おもひそめてし心たかふな",
   "kana": "",
   "speaker": "",
   "page": 65,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "36",
   "text": "きてなれし人はみねとも蘭をのか心とほころひにけり",
   "kana": "",
   "speaker": "",
   "page": 65,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "37",
   "text": "老せぬは汀のきくのしるしとも流をくめる人そしりける",
   "kana": "",
   "speaker": "",
   "page": 65,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "38",
   "text": "君か代を長月にしも咲初て久しく匂ふしら菊の花",
   "kana": "",
   "speaker": "",
   "page": 65,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  }
 ],
